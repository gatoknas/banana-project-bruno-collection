meta {
  name: Get Revenue Summary
  type: http
  seq: 19
}

get {
  url: {{base_url}}/api/v1/email-receipts/summary?from=2026-09-01&to=2026-09-23
  body: none
  auth: inherit
}

params:query {
  from: 2026-09-01
  to: 2026-09-23
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("response has valid revenue summary structure", function() {
    const data = res.getBody();
    expect(data).to.have.property('totalRevenue');
    expect(data).to.have.property('transactionCount');
    expect(data).to.have.property('averageTicket');
    expect(data).to.have.property('previousPeriodRevenue');
    expect(data).to.have.property('growthPercentage');
    expect(data).to.have.property('currency');
    expect(data).to.have.property('timeline');
    expect(Array.isArray(data.timeline)).to.be.true;
  });
}
