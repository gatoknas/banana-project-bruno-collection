meta {
  name: Update Purchase
  type: http
  seq: 29
}

put {
  url: {{base_url}}/api/v1/purchases/{{purchase_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "supplierId": 1,
    "invoiceNumber": "FAC-2026-001-REV",
    "purchaseDate": "2026-09-24T10:00:00Z",
    "notes": "Compra semanal de fruta e insumos - Corregida",
    "items": [
      {
        "productId": 1,
        "purchaseUnitId": 3,
        "quantityPurchased": 3.0,
        "conversionFactor": 20.0,
        "unitCost": 58000.0
      }
    ]
  }
}

docs {
  Updates an existing restock purchase order.
  Atomically reverts prior line stock and weighted average cost (PMP) contributions,
  deletes previous items, updates header metadata, inserts new items, applies new inventory
  stock increments, and recomputes the weighted average cost (PMP).
  Requires the ayurami-admin or ayurami-salesperson role.
}
