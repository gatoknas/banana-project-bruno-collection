meta {
  name: Create Supplier
  type: http
  seq: 21
}

post {
  url: {{base_url}}/api/v1/suppliers
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "companyName": "Distribuidora Frutera S.A.",
    "contactName": "Carlos Mendoza",
    "phone": "+57 300 123 4567",
    "email": "contacto@distrifrutera.com",
    "taxId": "900123456-7",
    "description": "Proveedor principal de fruta fresca y pulpa congelada"
  }
}

docs {
  Registers a new raw materials / goods supplier.
  - Required fields: `companyName` (string) and `phone` (string).
  - Optional fields: `taxId` (string/null, unique when provided), `contactName` (string), `email` (string), and `description` (string/null).
  Requires the ayurami-admin role.
}

