meta {
  name: Sync Receipts (Google Sheets)
  type: http
  seq: 17
}

docs {
  Syncs digital-payment receipt registers on-demand from the Google Sheets document (`Datos_Ventas`).
  Deduplication is handled automatically via `message_id` (Column J: `ID Mensaje`).
  The body can be empty `{}` for a full on-demand sync, or `{ "from": "YYYY-MM-DD", "to": "YYYY-MM-DD" }` to filter by date range.
}

post {
  url: {{base_url}}/api/v1/email-receipts/sync
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "from": "2026-09-01",
    "to": "2026-09-24"
  }
}
